# Comma-separated client names and SHA-256 hashes of their tokens.
# Hash the exact HEXAPODS_TOKEN text stored on each client.
HEXAPODS_TOKEN_HASHES=local:REPLACE_WITH_LOCAL_TOKEN_SHA256,raspi:REPLACE_WITH_RASPI_TOKEN_SHA256

# Direct LAN access; use 127.0.0.1:9877 behind a TLS reverse proxy.
SERVER_BIND=0.0.0.0:9877

# Optional: exact HTTPS origin allowed to sign in with the browser viewer.
# HEXAPODS_BROWSER_ORIGIN=https://hexapods.example.com
