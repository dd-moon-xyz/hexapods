# Full WebSocket URL. Use wss://YOUR_DOMAIN/ws through TLS for internet access.
SERVER_URL=ws://192.168.0.15:9877/ws

# Original Raspberry Pi token; the server stores its SHA-256 hash under raspi.
HEXAPODS_TOKEN=REPLACE_WITH_RASPI_TOKEN

# Optional fallback host:port, used only when SERVER_URL is unset.
# SERVER_ADDRESS=192.168.0.15:9877
